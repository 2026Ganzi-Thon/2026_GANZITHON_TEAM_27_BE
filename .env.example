# 로컬 개발: 비워 두면 SQLite(./arithon.db)
# Supabase: Project Settings > Database > Connection string (URI)
# 예) postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=
DB_SCHEMA=court
AUTO_CREATE_TABLES=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# AI: auto(키가 있는 공급자 사용, 없으면 규칙 기반) | gemini | openai | fallback
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# true 면 게시글을 검토 없이 바로 published (전시 시연용)
BOARD_AUTO_PUBLISH=false
